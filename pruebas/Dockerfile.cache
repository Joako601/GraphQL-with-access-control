# Alternativa reproducible cuando la red de Docker descarga lentamente.
# El contexto deps contiene paquetes Linux / CPython 3.11, no el .venv de Windows.
FROM python:3.11-slim
WORKDIR /app
COPY --from=deps / /usr/local/lib/python3.11/site-packages/
COPY . .
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
