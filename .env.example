# Copiar antes de iniciar: Copy-Item .env.example .env
# Sustituir las claves de ejemplo en .env y ejecutar: docker compose up -d --build
# Las variables POSTGRES_* internas corresponden a la red de Docker.
APP_PORT=8004
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5434
POSTGRES_DB=sistema_financiero
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave_local
JWT_SECRET=reemplaza_con_un_secreto_aleatorio_local
JWT_EXPIRE_MINUTES=60
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=cambia_esta_clave_local
